#!/bin/sh /etc/rc.common
# shellcheck shell=sh disable=SC2034,SC3043

START=95
STOP=10
USE_PROCD=1

BIN=/usr/bin/csqtt-client
RUNTIME_DIR=/var/run/csqtt
CREDENTIALS_FILE=$RUNTIME_DIR/credentials.json
TUN_HOOK=/usr/libexec/csqtt-tun

append_option() {
	local option="$1"
	local value="$2"
	[ -n "$value" ] && procd_append_param command "--$option" "$value"
}

start_service() {
	local enabled mode peer password vk_hashes device_id workers obfs
	local turn_transport turn_host turn_port tun_device socks5_listen

	config_load csqtt
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get mode main mode tun
	config_get peer main peer
	config_get password main password
	config_get vk_hashes main vk_hashes
	config_get device_id main device_id openwrt-router
	config_get workers main workers 18
	config_get obfs main obfs audio
	config_get turn_transport main turn_transport udp
	config_get turn_host main turn_host
	config_get turn_port main turn_port
	config_get tun_device main tun_device csqtt0
	config_get socks5_listen main socks5_listen 127.0.0.1:1080

	[ -x "$BIN" ] || { logger -t csqtt "missing $BIN"; return 1; }
	[ -n "$peer" ] || { logger -t csqtt "uci csqtt.main.peer is required"; return 1; }
	[ -n "$password" ] || { logger -t csqtt "uci csqtt.main.password is required"; return 1; }
	[ -n "$vk_hashes" ] || { logger -t csqtt "uci csqtt.main.vk_hashes is required"; return 1; }
	[ "$mode" = tun ] || [ "$mode" = socks5 ] || {
		logger -t csqtt "mode must be tun or socks5"
		return 1
	}

	umask 077
	mkdir -p "$RUNTIME_DIR" || return 1
	# shellcheck source=/dev/null
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string password "$password"
	json_add_string vk "$vk_hashes"
	json_dump >"$CREDENTIALS_FILE" || return 1

	procd_open_instance
	procd_set_param command "$BIN"
	append_option peer "$peer"
	append_option credentials-file "$CREDENTIALS_FILE"
	append_option device-id "$device_id"
	append_option workers "$workers"
	append_option obfs "$obfs"
	append_option turn-transport "$turn_transport"
	append_option turn "$turn_host"
	append_option port "$turn_port"
	if [ "$mode" = tun ]; then
		append_option tun-device "$tun_device"
		append_option tun-config-hook "$TUN_HOOK"
	else
		append_option socks5 "$socks5_listen"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

stop_service() {
	[ -x "$TUN_HOOK" ] && "$TUN_HOOK" down
	rm -f "$CREDENTIALS_FILE"
}

service_triggers() {
	procd_add_reload_trigger csqtt
}
